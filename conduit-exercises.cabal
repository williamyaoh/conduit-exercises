cabal-version:      3.0
name:               conduit-exercises
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             William Yao
maintainer:         williamyaoh@gmail.com
-- copyright:
build-type:         Simple
-- extra-source-files:

common options
    ghc-options: -Wall -threaded -rtsopts

library
    import:           options
    exposed-modules:  
      Exercise1
      Exercise2
      Exercise3
      Exercise4
      Exercise5
    build-depends:
        base ==4.*
      , async
      , bytestring
      , conduit
      , conduit-extra
      , containers
      , mtl
      , network
      , random
      , resourcet
      , rot13
      , text
      , transformers
    hs-source-dirs:   src/lib
    default-language: Haskell2010

executable exercise2
    import: options
    main-is: exercise2.hs
    hs-source-dirs: src/bin
    build-depends:
        base ==4.*
      , conduit-exercises
    default-language: Haskell2010
